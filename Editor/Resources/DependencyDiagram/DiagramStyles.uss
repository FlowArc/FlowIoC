/* General diagram styles */
.diagram-content {
    background-color: #1e1e1e;
}

/* Toolbar styles */
.diagram-toolbar {
    background-color: #2d2d2d;
    border-bottom-width: 1px;
    border-bottom-color: #3c3c3c;
}

/* Status bar styles */
.diagram-status-bar {
    background-color: #2d2d2d;
    border-top-width: 1px;
    border-top-color: #3c3c3c;
}

/* Graph stilleri */
.graph {
    background-color: #252525;
}

/* Node stilleri */
.diagram-node {
    min-width: 150px;
    max-width: 300px;
    margin: 10px;
    border-width: 1px;
    border-radius: 5px;
    padding: 8px;
    background-color: #383838;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.5);
}

.diagram-node:hover {
    border-width: 2px;
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.6);
}

.diagram-node:selected {
    border-width: 2px;
    border-color: #66AAFF;
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.6);
}

.diagram-node .title-container {
    padding: 8px;
    border-radius: 3px;
    margin-bottom: 5px;
}

.diagram-node .title {
    font-size: 14px;
    font-weight: bold;
    margin-bottom: 3px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.diagram-node .type {
    font-size: 11px;
    color: #aaaaaa;
    margin-bottom: 5px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.diagram-node #title {
    font-size: 14px;
    font-weight: bold;
    margin-bottom: 3px;
    -unity-text-align: middle-center;
}

.diagram-node-type {
    font-size: 11px;
    color: #aaaaaa;
    margin-bottom: 5px;
    -unity-text-align: middle-center;
}

/* Port stilleri */
.diagram-node-port {
    min-height: 24px;
    background-color: rgba(40, 40, 40, 0.8);
    border-radius: 3px;
    margin: 2px;
}

/* Port etiketleri için stil */
.port-label {
    color: #cccccc;
    font-size: 10px;
    margin-left: 3px;
    margin-right: 3px;
}

Port {
    --port-color: #AAAAAA;
    height: 18px;
    width: 18px;
}

Port:hover {
    --port-color: #66AAFF;
    height: 20px;
    width: 20px;
}

/* Node tiplerine göre renkler */
.context-node, .context-group {
    background-color: rgba(51, 102, 153, 0.3);
    border-color: rgba(51, 102, 153, 0.7);
}

.signal-node, .signal-group {
    background-color: rgba(153, 51, 51, 0.3);
    border-color: rgba(153, 51, 51, 0.7);
}

.command-node, .command-group {
    background-color: rgba(102, 153, 51, 0.3);
    border-color: rgba(102, 153, 51, 0.7);
}

.view-node, .view-group {
    background-color: rgba(51, 153, 153, 0.3);
    border-color: rgba(51, 153, 153, 0.7);
}

.mediator-node, .mediator-group {
    background-color: rgba(153, 51, 153, 0.3);
    border-color: rgba(153, 51, 153, 0.7);
}

.injectable-node, .injectable-group {
    background-color: rgba(153, 102, 51, 0.3);
    border-color: rgba(153, 102, 51, 0.7);
}

/* Group stilleri */
.diagram-group {
    background-color: rgba(26, 26, 26, 0.2);
    border-width: 1px;
    border-radius: 5px;
}

.diagram-group > .title {
    font-size: 14px;
    font-weight: bold;
}

/* Edge stilleri */
.edge {
    --edge-width: 1; /* Temel kenar kalınlığı */
}

.diagram-edge {
    --edge-width: 2;
    --edge-color: #BBBBBB;
}

/* Kenar tipine göre özel stiller */
.signal-edge {
    opacity: 0.9;
    --edge-color: rgba(153, 51, 51, 1);
}

.command-edge {
    opacity: 1.0;
    --edge-color: rgba(102, 153, 51, 1);
}

.mediator-edge {
    opacity: 0.9;
    --edge-color: rgba(153, 51, 153, 1);
}

.view-edge {
    opacity: 0.8;
    --edge-color: rgba(51, 153, 153, 1);
}

.injectable-edge {
    opacity: 0.8;
    --edge-color: rgba(153, 102, 51, 1);
}

.injection-edge {
    --edge-width: 2;
    --edge-color: rgba(51, 102, 153, 1);
}

.sequential-edge {
    --edge-width: 2;
    --edge-color: rgba(153, 51, 51, 1);
}

.parallel-edge {
    --edge-width: 2;
    --edge-color: rgba(153, 51, 153, 1);
}

.default-edge {
    opacity: 0.7;
    --edge-color: #AAAAAA;
}

/* Edge etiketleri */
Label.edge__label {
    background-color: rgba(50, 50, 50, 0.7);
    color: #cccccc;
    font-size: 10px;
    border-radius: 3px;
    padding: 2px 4px;
    margin: 2px;
}

/* Edge Label stilleri */
.edge-title {
    font-size: 11px;
    background-color: rgba(0, 0, 0, 0.7);
    border-radius: 3px;
    padding: 2px 4px;
    margin-top: 2px;
    color: #cccccc;
}

/* Edge Tip stilleri */
.edge-control__tip {
    border-radius: 2px;
    height: 6px;
    width: 6px;
}

/* Tooltip stilleri */
.tooltip {
    background-color: rgba(0, 0, 0, 0.8);
    border-radius: 3px;
    padding: 5px;
    color: #cccccc;
    font-size: 11px;
}

/* Button styles */
Button {
    background-color: #3c3c3c;
    border-width: 1px;
    border-color: #555555;
    border-radius: 3px;
    color: #cccccc;
    padding: 5px 10px;
}

Button:hover {
    background-color: #4c4c4c;
    border-color: #707070;
}

Button:active {
    background-color: #2c2c2c;
    border-color: #909090;
}

/* Label styles */
Label {
    color: #cccccc;
}

/* Context group styles */
.context-group {
    background-color: rgba(51, 102, 153, 0.2);
    border-color: rgba(51, 102, 153, 0.5);
}

/* Signal group styles */
.signal-group {
    background-color: rgba(153, 51, 51, 0.2);
    border-color: rgba(153, 51, 51, 0.5);
}

/* Command group styles */
.command-group {
    background-color: rgba(102, 153, 51, 0.2);
    border-color: rgba(102, 153, 51, 0.5);
}

/* View group styles */
.view-group {
    background-color: rgba(51, 153, 153, 0.2);
    border-color: rgba(51, 153, 153, 0.5);
}

/* Mediator group styles */
.mediator-group {
    background-color: rgba(153, 51, 153, 0.2);
    border-color: rgba(153, 51, 153, 0.5);
}

/* Injectable group styles */
.injectable-group {
    background-color: rgba(153, 102, 51, 0.2);
    border-color: rgba(153, 102, 51, 0.5);
} 